<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Least-privilege entitlements (spec §18). Every entry is documented in docs/RELEASE.md.
  No Full Disk Access, no root helper, no Apple Events / accessibility automation.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Folders the user picks in an open panel, kept via security-scoped bookmarks. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
	<!-- Model providers and Google APIs. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- One-shot 127.0.0.1 listener for the installed-app OAuth redirect. -->
	<key>com.apple.security.network.server</key>
	<true/>
	<!-- EventKit (selected calendars). -->
	<key>com.apple.security.personal-information.calendars</key>
	<true/>
</dict>
</plist>
